APP_ENV=development
ADMIN_API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/aitutors
REDIS_URL=redis://localhost:16379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aitutors
MINIO_SECURE=false

LLM_GATEWAY_MODE=mock
DEEPSEEK_API_KEY=
MIMO_API_KEY=
QWEN_VL_API_KEY=
PADDLEOCR_VL_TOKEN=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
QWEN_VL_BASE_URL=https://ws-4jjhl5ng7gjgbfbv.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.7-plus
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=2560
LLM_REQUEST_TIMEOUT_SECONDS=60
PADDLEOCR_API_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_POLL_INTERVAL_SECONDS=5
PADDLEOCR_JOB_TIMEOUT_SECONDS=600
NATIVE_MARKDOWN_ENABLED=true
NATIVE_TEXT_THRESHOLD=0.6

OCR_MOCK_MODE=true
EMBEDDING_MOCK_MODE=true
