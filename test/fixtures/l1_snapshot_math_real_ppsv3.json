    },
    {
      "line_id": "P2L009",
      "page_no": 2,
      "line_no_in_page": 9,
      "order": 9,
      "text": "（12）函数$f(x)=\\log_{2}(1-x)+\\frac{1}{x}$ 的定义域为",
