      "page_no": 1,
      "line_no_in_page": 8,
      "order": 8,
      "text": "（1）（集团校自创题）",
      "block_type": "text",
      "source": "ppsv3",
      "continuation": false
    },
    {
      "line_id": "P1L009",
      "page_no": 1,
      "line_no_in_page": 9,
      "order": 9,
      "text": "（2）下列函数中，在定义域内单调递减且值域为$(0,+\\infty)$ 的是",
