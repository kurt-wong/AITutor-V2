    },
    {
      "line_id": "P1L011",
      "page_no": 1,
      "line_no_in_page": 11,
      "order": 11,
      "text": "（3）命题$ \\text{\"}\\forall x>0\\text{\"}$ ，都有$\\sin x<x$ ”的否定为",
