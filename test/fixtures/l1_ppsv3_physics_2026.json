    },
    {
      "line_id": "P2L002",
      "page_no": 2,
      "line_no_in_page": 2,
      "order": 33,
      "text": "↑\n\nV1\n\n甲\n\n乙\n\nV2\n\nO t1t21一",
      "block_type": "figure_placeholder",
