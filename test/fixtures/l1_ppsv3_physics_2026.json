      "line_no_in_page": 12,
      "order": 181,
      "text": "分析：小车未被拉动时：$F=m g$",
      "block_type": "text",
      "source": "ppsv3"
    },
    {
      "line_id": "P9L013",
      "page_no": 9,
      "line_no_in_page": 13,
      "order": 182,
      "text": "小车被拉动时：对M列方程$F-f=M a$",
      "block_type": "text",
      "source": "ppsv3"
    },
    {
      "line_id": "P9L014",
      "page_no": 9,
      "line_no_in_page": 14,
      "order": 183,
      "text": "对m列方程$mg-F=ma$",
      "block_type": "text",
      "source": "ppsv3"
    },
    {
      "line_id": "P9L015",
      "page_no": 9,
      "line_no_in_page": 15,
      "order": 184,
      "text": "解方程组得$F=\\frac{m}{m+M}(Mg+f)$",
      "block_type": "text",
      "source": "ppsv3"
    },
    {
      "line_id": "P9L016",
      "page_no": 9,
      "line_no_in_page": 16,
      "order": 185,
      "text": "当$M\\gg\\geq m$ 时，$F=m g$",
      "block_type": "text",
      "source": "ppsv3"
    },
    {
      "line_id": "P9L017",
      "page_no": 9,
      "line_no_in_page": 17,
      "order": 186,
      "text": "当$M<<m$ 时，$F=M g+f$ 、（为定值）",
