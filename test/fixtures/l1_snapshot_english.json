    {"line_id": "P1L002", "page_no": 1, "line_no_in_page": 2, "order": 2, "text": "Part I: Multiple Choice (2 points each, 20 points total)", "block_type": "text", "source": "native", "continuation": false},
    {"line_id": "P1L003", "page_no": 1, "line_no_in_page": 3, "order": 3, "text": "1. The book ______ by the famous author last year.", "block_type": "text", "source": "native", "continuation": false},
