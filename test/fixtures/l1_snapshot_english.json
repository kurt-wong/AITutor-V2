    {"line_id": "P1L012", "page_no": 1, "line_no_in_page": 12, "order": 12, "text": "D. have studied", "block_type": "text", "source": "native", "continuation": false},
    {"line_id": "P1L013", "page_no": 1, "line_no_in_page": 13, "order": 13, "text": "3. The reason ______ he was late was that he missed the bus.", "block_type": "text", "source": "native", "continuation": false},
    {"line_id": "P1L014", "page_no": 1, "line_no_in_page": 14, "order": 14, "text": "A. that", "block_type": "text", "source": "native", "continuation": false},
