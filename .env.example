# Runtime
APP_ENV=development
ADMIN_API_KEY=change-me

# PostgreSQL
POSTGRES_DB=aitutors
POSTGRES_USER=aitutors
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=aitutors
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=aitutors
MINIO_SECURE=false

# LLM Gateway
LLM_GATEWAY_MODE=mock
DEEPSEEK_API_KEY=
MIMO_API_KEY=
PADDLEOCR_VL_TOKEN=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_VL_MODEL=deepseek-v4-flash-vision-exp
MIMO_BASE_URL=
MIMO_MODEL=
MIMO_VL_MODEL=mimo-v2.5
OLLAMA_BASE_URL=
OLLAMA_MODEL=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=2560
LLM_REQUEST_TIMEOUT_SECONDS=60

# Mock switches
OCR_MOCK_MODE=true
EMBEDDING_MOCK_MODE=true
